# Clé API Google Gemini
GOOGLE_API_KEY=

# Clé API OpenAI (fallback si quota Gemini)
OPENAI_API_KEY=

# Modèles (optionnel)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Token KoboToolbox (formulaires privés)
KOBOTOOLBOX_TOKEN=

# Modèle Gemma local (optionnel, laisser vide sur Streamlit Cloud)
LOCAL_GEMMA_PATH=
